# ============================================================
# RGM-INFRA — Variáveis de ambiente
# Copie para .env e ajuste conforme o ambiente.
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=rgm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Porta exposta no host (evita conflito com PostgreSQL local na 5432)
POSTGRES_PORT=5434

# ── MinIO ───────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=images
# Obrigatória em produção (docker-compose.prod.yml): URL do MinIO alcançável
# pelo navegador do usuário final — usada para montar o link das evidências.
# Sem isso, os links de foto ficam apontando para o endereço interno do
# Docker e não abrem fora da rede. Em dev, o default abaixo já funciona
# porque a porta 9000 do MinIO é publicada no host.
MINIO_PUBLIC_URL=http://localhost:9000

# ── JWT (obrigatório em produção — mínimo 32 caracteres) ────
JWT_SECRET=

# ── CORS ────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend (dev) ──────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api

# ── Imagens Docker (produção) ───────────────────────────────
# Publicadas automaticamente pelo pipeline release (push de tag v*.*.*).
# Produção consome as imagens já publicadas no GHCR (nenhum build local é
# necessário — docker-compose.prod.yml não tem seção `build:`). Ajuste a tag
# aqui apenas se quiser fixar uma versão específica (ex.: v1.2.0) em vez de
# `latest`.
BACKEND_IMAGE=ghcr.io/otavioprocopio/rgm-backend:latest
FRONTEND_IMAGE=ghcr.io/otavioprocopio/rgm-frontend:latest

# ── E2E (Playwright) ────────────────────────────────────────
E2E_ADMIN_EMAIL=admin@rgm.com
E2E_ADMIN_PASSWORD=admin123

# ── Monitoramento (Prometheus + Grafana) ────────────────────
GRAFANA_PASSWORD=admin
